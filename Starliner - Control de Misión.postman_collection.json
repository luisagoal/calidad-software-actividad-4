    {
      "name": "Reloj de la cápsula (MET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();\r\nconst datos = respuesta.json || respuesta.data;\r\nconst tiempoCohete = Number(pm.collectionVariables.get(\"tiempo_cohete\"));\r\n\r\npm.test(\"El servicio responde con estado 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"El reloj de la cápsula está sincronizado con el del cohete\", function () {\r\n    const diferencia = Math.abs(datos.tiempo_mision_seg - tiempoCohete);\r\n    pm.expect(diferencia, \"Diferencia en segundos\").to.be.at.most(1);\r\n});"
            ]
          }
        }
      ],
