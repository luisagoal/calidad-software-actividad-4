            "exec": [
              "const respuesta = pm.response.json();\r\nconst datos = respuesta.json || respuesta.data;\r\n\r\npm.test(\"El servicio responde con estado 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La secuencia de separación no presenta riesgo de colisión\", function () {\r\n    pm.expect(datos.riesgo_colision).to.eql(false);\r\n});\r\n\r\npm.test(\"El tiempo de respuesta es menor a 2 segundos\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});"
