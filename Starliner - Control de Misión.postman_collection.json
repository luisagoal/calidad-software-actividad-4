      "name": "Tiempo del cohete",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();\r\nconst datos = respuesta.json || respuesta.data;\r\n\r\npm.test(\"El servicio responde con estado 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La telemetría del cohete incluye el tiempo de misión\", function () {\r\n    pm.expect(datos).to.have.property(\"tiempo_mision_seg\");\r\n    pm.expect(datos.tiempo_mision_seg).to.be.a(\"number\");\r\n});\r\n\r\n// Guarda el tiempo del cohete para compararlo con el de la cápsula\r\npm.collectionVariables.set(\"tiempo_cohete\", datos.tiempo_mision_seg);"
            ]
          }
        }
      ],
